[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://scripts/menu_background.gd" id="2_bg"]
[ext_resource type="PackedScene" path="res://scenes/settings_menu.tscn" id="3_sett"]
[ext_resource type="PackedScene" path="res://scenes/credits_menu.tscn" id="4_cred"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="MenuBackground" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_bg")

[node name="ContentLayer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MainMargin" type="MarginContainer" parent="ContentLayer"]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="MainVBox" type="VBoxContainer" parent="ContentLayer/MainMargin"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 28
alignment = 1

[node name="TitleContainer" type="VBoxContainer" parent="ContentLayer/MainMargin/MainVBox"]
layout_mode = 2
theme_override_constants/separation = 4
alignment = 1

[node name="StatusBadge" type="Label" parent="ContentLayer/MainMargin/MainVBox/TitleContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.35, 0.45, 0.9)
theme_override_font_sizes/font_size = 12
text = "BIOLOGICAL INVASION SYSTEM // PHASE 1 ACTIVE"
horizontal_alignment = 1

[node name="TitleLabel" type="Label" parent="ContentLayer/MainMargin/MainVBox/TitleContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.95, 0.96, 1)
theme_override_colors/font_shadow_color = Color(0.85, 0.15, 0.3, 0.7)
theme_override_constants/shadow_offset_x = 0
theme_override_constants/shadow_offset_y = 4
theme_override_font_sizes/font_size = 56
text = "INVASION"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="ContentLayer/MainMargin/MainVBox/TitleContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.55, 0.65, 1)
theme_override_font_sizes/font_size = 16
text = "INSIDE THE HUMAN BODY"
horizontal_alignment = 1

[node name="ButtonContainer" type="VBoxContainer" parent="ContentLayer/MainMargin/MainVBox"]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 12

[node name="PlayButton" type="Button" parent="ContentLayer/MainMargin/MainVBox/ButtonContainer"]
custom_minimum_size = Vector2(280, 50)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "SINGLE PLAYER"

[node name="MultiplayerButton" type="Button" parent="ContentLayer/MainMargin/MainVBox/ButtonContainer"]
custom_minimum_size = Vector2(280, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "MULTIPLAYER"

[node name="LevelSelectButton" type="Button" parent="ContentLayer/MainMargin/MainVBox/ButtonContainer"]
custom_minimum_size = Vector2(280, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "LEVEL SELECTION"

[node name="SettingsButton" type="Button" parent="ContentLayer/MainMargin/MainVBox/ButtonContainer"]
custom_minimum_size = Vector2(280, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "SETTINGS"

[node name="CreditsButton" type="Button" parent="ContentLayer/MainMargin/MainVBox/ButtonContainer"]
custom_minimum_size = Vector2(280, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "CREDITS"

[node name="QuitButton" type="Button" parent="ContentLayer/MainMargin/MainVBox/ButtonContainer"]
custom_minimum_size = Vector2(280, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "QUIT GAME"

[node name="ModalOverlay" type="ColorRect" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.01, 0.02, 0.85)

[node name="SettingsMenu" parent="ModalOverlay" instance=ExtResource("3_sett")]
layout_mode = 1

[node name="CreditsMenu" parent="ModalOverlay" instance=ExtResource("4_cred")]
layout_mode = 1
